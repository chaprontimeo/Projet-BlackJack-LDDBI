import random

paquet = 4*["As","2","3","4","5","6","7","8","9","10","Valet","Reinne","Roi"]

def paquet_melange(paquet):
    nouveau_paquet = []
    while len(paquet) > 0:
        numero_carte = random.randint(0, len(paquet)-1)
        nouveau_paquet.append(paquet.pop(numero_carte))
    return nouveau_paquet
    

def tirer_cartes(liste):
    carte = liste.pop()
    return carte

def creer_main(liste):                                              #main va etre = a joueur au fil du code
    main  = []
    main.append(tirer_cartes(liste))
    main.append(tirer_cartes(liste))
    return main

def calculer_score(joueur):
    score = 0
    nombre_as = 0
    for carte in joueur:
        if carte == "As":
            score += 11
            nombre_as += 1
        elif carte in ["2","3","4","5","6","7","8","9","10"]:
            score += int(carte)
        elif carte in ["Valet","Reinne","Roi"]:
            score += 10
    while score > 21 and nombre_as > 0:
        score -= 10
        nombre_as -= 1
    return score

def brule(joueur):
    est_brule = False
    if calculer_score(joueur) > 21:
        est_brule = True
    return est_brule

def tour_joueur(joueur,liste,mise):
    actions = ["Hit","Stand","DoubleDown","Surrender"]
    est_vrai = True
    while est_vrai == True:
        action = input("Que voulez vous faire? (Hit/Stand/DoubleDown/Surrender) ")
        if action in actions:
            est_vrai = False
        else:
            print("Ce n'est pas une action ou vous l'avez mal orthographié")
    if action == "DoubleDown":
        if len(joueur) == 2 and calculer_score(joueur) in [9,10,11]:
            mise = mise * 2
            carte = tirer_cartes(liste)
            print("Carte tirée :", carte)
            joueur.append(carte)
            print("Votre score :", calculer_score(joueur))
            return mise
        else:
            print("Vous ne pouvez pas faire cette action, vous devez tirer une carte")
            action = "Hit"
    if action == "Hit":
        continuer = True
        while continuer == True:
            carte = tirer_cartes(liste)
            print("Vous avez tirer la carte", carte)
            joueur.append(carte)
            print(joueur)
            print("Vous avez",calculer_score(joueur), "points")
            if brule(joueur) == True:
                print("Vous avez trop de points, fin du tour ")
                return mise
            if calculer_score(joueur) == 21:
                print("Vous avez gagné")
                break
            if brule(joueur) == False:
                fin_tour = input("Voulez-vous continuer? (True/False) ")
                if fin_tour == "False":
                    continuer = False
                    print("Votre tour est terminé")
        return mise
    if action == "Stand":
        print("Vous passez votre tour")
        return mise
    if action == "Surrender":
        print("Vous avez abandonné")
        return None

def tour_croupier(croupier, paquet):
    continuer = True
    while continuer == True:
        score = calculer_score(croupier)
        print("Croupier :", croupier, "=", score, "points")
        if score < 17:
            carte = tirer_cartes(paquet)
            print("Le croupier tire", carte)
            croupier.append(carte)
        else:
            print("Le croupier s'arrête")
            continuer = False

def comparer_scores(joueur, croupier, mise):
    if mise != None:
        score_joueur = calculer_score(joueur)
        score_croupier = calculer_score(croupier)
        print("Score joueur :", score_joueur)
        print("Score croupier :", score_croupier)
        if score_joueur > 21:
            print("Vous perdez", mise)
            return -mise
        if score_croupier > 21:
            print("Vous gagnez", mise)
            return mise
        if score_joueur > score_croupier:
            print("Vous gagnez", mise)
            return mise
        elif score_joueur < score_croupier:
            print("Vous perdez", mise)
            return -mise
        else:
            print("Egalité")
            return 0
    elif mise == None:
        return mise//2
    
def jouer_tour(joueur,croupier,paquet_carte,mise_de_base):
    print("Votre main :", joueur)
    print("Croupier :", [croupier[0], "?"])
    nouvelle_mise = 0
    bonne_mise = False
    while bonne_mise == False:
        mise = int(input("Combien voulez-vous miser ? "))
        if mise_de_base >= mise:
            bonne_mise = True
        else:
            print("Vous ne pouvez pas miser cette somme")
    mise = tour_joueur(joueur, paquet_carte, mise)
    if mise == None:
        nouvelle_mise = mise_de_base//2
        return nouvelle_mise
    elif mise != None:
        if brule(joueur) == False:
            tour_croupier(croupier, paquet_carte)
            gain = comparer_scores(joueur, croupier, mise)
            nouvelle_mise += gain
        return nouvelle_mise


def jouer(nb_joueur,paquet):
    paquet_carte = paquet_melange(paquet)
    mise_de_base = 50
    i = 1
    liste_joueurs = []
    while i != nb_joueur+1:
        joueur = creer_main(paquet_carte)
        liste_joueurs.append(joueur)
        i += 1
    croupier = creer_main(paquet_carte)
    copie_croupier = croupier.copy()
    print(liste_joueurs)
    for joueur in liste_joueurs:
        jouer_tour(joueur,croupier,paquet_carte,mise_de_base)
        print(croupier)
        print(copie_croupier)
        croupier = copie_croupier.copy()
    return liste_joueurs, croupier

